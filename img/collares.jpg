_exposures\":[{\"gate\":\"444232970\",\"gateValue\":\"false\",\"ruleID\":\"gbNhJYZt2LT0MMPpBwPnn\"}],\"version\":19,\"id_type\":\"userID\",\"value\":{\"tempDisabled\":false,\"kind\":\"social\",\"loginStrategy\":\"existing_user\",\"name\":\"microsoft\",\"enabled\":true},\"is_device_based\":false,\"passed\":false},\"1623104352\":{\"name\":\"1623104352\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":25,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"user_prompt_key\":\"good_option\",\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"enable_web_search\":false},\"is_device_based\":false,\"passed\":false},\"2433713709\":{\"name\":\"2433713709\",\"rule_id\":\"4KU5vMgln0RfRQV6ltwqKs:100.00:3-4Viuasc1mPfBqiE0jyFfZl\",\"secondary_exposures\":[],\"version\":92,\"id_type\":\"userID\",\"value\":{\"ducking_vad_frame_duration_ms\":10,\"ducking_assistant_echo_gate_capture_baseline_ratio\":1.8,\"ducking_vad_aggressiveness\":3,\"ducking_ducked_remote_volume\":0.1,\"ducking_assistant_echo_gate_enabled\":false,\"ducking_assistant_echo_gate_render_hold_ms\":500,\"ducking_assistant_echo_gate_render_active_threshold\":0.02,\"ducking_assistant_echo_gate_capture_to_render_ratio\":0.8,\"ducking_restoration_steps\":20,\"webrtc_echo_cancellation_enabled\":false,\"ducking_assistant_echo_gate_minimum_capture_level\":0.04,\"ducking_restoration_duration_ms\":1000,\"high_confidence_headset_regexes\":[],\"ducking_duck_inactive_hold_ms\":300,\"ducking_version\":1,\"hardware_echo_cancellation_enabled\":true,\"ducking_ducked_remote_volume_db\":-6,\"ducking_device_policy\":\"only_speakerphone\",\"ducking_vad_backend\":\"webrtc\",\"ducking_duck_minimum_duration_ms\":750},\"is_device_based\":false,\"passed\":true},\"1217873841\":{\"name\":\"1217873841\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":41,\"id_type\":\"userID\",\"value\":{\"model_slug\":\"gpt-5-5-instant\"},\"is_device_based\":false,\"passed\":false},\"489084288\":{\"name\":\"489084288\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"id_type\":\"stableID\",\"value\":{\"options\":[\"google\",\"apple\",\"microsoft\",\"email\",\"phone_number\"]},\"is_device_based\":true,\"passed\":false},\"3119290944\":{\"name\":\"3119290944\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[{\"gate\":\"958